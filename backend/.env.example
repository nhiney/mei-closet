# --- CORE CONFIG ---
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mei-closet
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://meicloset.com

# --- CLOUDINARY (Images) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- OPENAI (AI Descriptions) ---
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# --- AUTH (Optional Social) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
